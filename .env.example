# Supabase connection — copy this file to ".env" and fill in your project values.
# Find these in your Supabase project:  Settings → API
#   Project URL  ->  VITE_SUPABASE_URL
#   Publishable / anon key  ->  VITE_SUPABASE_ANON_KEY
#
# The anon/publishable key is safe to expose in the browser — your data is
# protected by Row Level Security (see supabase/schema.sql).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY


